{
  "name": "blogic-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run check.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c ./.oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint -c ./.oxlintrc.json --fix .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@blogic-cz/oxc-config": "1.5.7",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.10"
}
