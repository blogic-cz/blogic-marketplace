{
  "name": "blogic-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run check.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c ./.oxlintrc.json --deny-warnings .",
    "lint:fix": "oxlint -c ./.oxlintrc.json --fix .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@blogic-cz/oxc-config": "1.5.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "lefthook": "^2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.10"
}
